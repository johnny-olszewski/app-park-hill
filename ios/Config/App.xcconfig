// App target settings shared by every environment. Each environment's
// xcconfig includes this file and sets APP_ENVIRONMENT.

PRODUCT_NAME = ParkHill
PRODUCT_BUNDLE_IDENTIFIER = $(PRODUCT_BUNDLE_IDENTIFIER_ROOT).$(APP_ENVIRONMENT_ID)

GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = $(APP_DISPLAY_NAME)
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait

// Build-time environment selection (guide 5.2). Every binding file and all
// mock sources are excluded, then only this environment's binding is added
// back. Mock responses and the dataset are mock data and excluded too. An environment
// that needs mocks (Mock) overrides the exclusion.
EXCLUDED_SOURCE_FILE_NAMES = ServiceBinding+*.swift DevToolsBinding+*.swift DevTools+*.swift */Mocks/* */contract/mock_responses */contract/seed $(DEV_TOOLS_EXCLUDED)
INCLUDED_SOURCE_FILE_NAMES = ServiceBinding+$(APP_ENVIRONMENT).swift $(DEV_TOOLS_SOURCES)

// Dev tools (EP-06): the pill and menu over the app. Every debug configuration
// compiles DevTools/, its Enabled binding and this environment's tools
// (DevTools+<environment>.swift). A release configuration compiles only the
// Disabled binding and excludes DevTools/, so no dev tools code ships.
DEV_TOOLS_SOURCES = DevToolsBinding+Enabled.swift DevTools+$(APP_ENVIRONMENT).swift
DEV_TOOLS_EXCLUDED =

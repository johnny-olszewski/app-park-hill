// Local tests: include integration tests against the configured backend (local
// Supabase by default). Mock sources do not exist in Local, so their tests are
// excluded.

#include "Tests.xcconfig"

EXCLUDED_SOURCE_FILE_NAMES = */Mocks/*
// Release builds of the app have no dev tools, so neither do their tests.
EXCLUDED_SOURCE_FILE_NAMES[config=Local-Release] = */Mocks/* */DevTools/*
